{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reactive/candidate-patch-v1.schema.json",
  "title": "Draft ReactiveCandidatePatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "base_definition_digest",
    "hypothesis",
    "mutations",
    "validation_profile"
  ],
  "properties": {
    "schema": {
      "const": "reactive.candidate-patch/v1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "base_definition_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "predicted_observation",
        "success_measure"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "predicted_observation": {
          "type": "string",
          "minLength": 1
        },
        "success_measure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op_id",
          "op",
          "target_ref",
          "preconditions",
          "read_set",
          "declared_effects",
          "scope"
        ],
        "properties": {
          "op_id": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "enum": [
              "component.create",
              "component.replace",
              "component.retire",
              "component.compose",
              "lens.bind",
              "lens.unbind",
              "observation.policy",
              "graph.connect",
              "graph.disconnect",
              "graph.replace_fragment",
              "context.view",
              "context.select",
              "context.order",
              "context.budget",
              "query.define",
              "query.use",
              "agent.demand_policy",
              "agent.tool_policy",
              "agent.verify_policy",
              "agent.delegation_policy",
              "swarm.role_projection",
              "swarm.coordination_policy",
              "federation.export",
              "federation.import",
              "federation.unbind",
              "improver.evidence_policy",
              "improver.proposal_policy",
              "improver.experiment_budget"
            ]
          },
          "target_ref": {
            "type": "string",
            "minLength": 1
          },
          "new_artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "read_set": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "declared_effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "expected_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "validation_profile": {
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "digest"
        ],
        "properties": {
          "artifact": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\.\\./).+$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
